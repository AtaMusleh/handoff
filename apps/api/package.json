{
  "name": "@handoff/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "dependencies": {
    "@handoff/domain": "1.0.0",
    "express": "^5.2.1",
    "socket.io": "^4.7.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "socket.io-client": "^4.7.2",
    "tsx": "^4.23.13"
  },
  "scripts": {
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:reset": "tsx --env-file=../../.env src/db/reset.ts",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  }
}
