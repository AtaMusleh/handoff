{
  "name": "@handoff/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "dependencies": {
    "@handoff/domain": "1.0.0",
    "express": "^5.2.1",
    "socket.io": "^4.7.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "socket.io-client": "^4.7.2"
  },
  "scripts": {
    "db:migrate": "node --experimental-strip-types --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "node --experimental-strip-types --env-file-if-exists=../../.env src/db/seed.ts",
    "db:reset": "node --experimental-strip-types --env-file-if-exists=../../.env src/db/reset.ts",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  }
}
