DATABASE_URL=postgresql://handoff_user:handoff_password@localhost:5432/handoff_dev
API_PORT=3001
API_URL=http://localhost:3001
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
ANTHROPIC_API_KEY=sk-your-api-key-here
# Current-generation model. Unset defaults to claude-opus-5 in the worker.
# claude-sonnet-5 ($2/$10 per MTok) is a sensible cost choice for this
# short-form summarization workload; claude-opus-5 is $5/$25.
# Was claude-sonnet-4-6 - a real model, but previous-generation AND more
# expensive than sonnet-5 ($3/$15), so there is no reason to prefer it.
ANTHROPIC_MODEL=claude-sonnet-5
# Signing secret for session tokens. REQUIRED in production - the API
# refuses to start without it rather than falling back to the development
# secret, which is a literal in middleware/auth.ts and therefore public.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=7d
LOG_LEVEL=info

# --- web (development identity; NOT authentication) ---
# Pre-fills the dashboard identity prompt so the stack can be run end to end
# before auth middleware exists. Anyone can change it in the browser.
NEXT_PUBLIC_DEV_USER_ID=
NEXT_PUBLIC_DEV_PROJECT_ID=

# --- realtime ---
# Gateway port, only used when running Socket.IO on its own server rather than
# attaching it to the Express app.
WS_PORT=3002
# Comma-separated browser origins allowed to open a websocket.
CORS_ORIGIN=http://localhost:3000

# --- handoff-brief worker ---
REDIS_URL=redis://localhost:6379
# Reasoning effort for brief generation: low | medium | high | xhigh | max.
# Low by default - summarization under a hard deadline does not repay more.
ANTHROPIC_EFFORT=low
# Hard deadline for the model call. Past this the deterministic fallback runs.
BRIEF_TIMEOUT_MS=30000
BRIEF_MAX_TOKENS=8000
# Bull retry policy. The Anthropic SDK's own retries are disabled so these are
# the only retries - otherwise 3 attempts x 3 SDK retries = 9 API calls.
BRIEF_ATTEMPTS=3
BRIEF_BACKOFF_MS=2000

# --- development login ---
# POST /auth/dev-login issues a valid session to any caller. It is mounted only
# when NODE_ENV is not "production" and 404s otherwise. On a shared dev or
# staging box, set this and send it as the x-dev-login-key header.
DEV_LOGIN_KEY=
