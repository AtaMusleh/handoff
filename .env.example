# =============================================================================
# Handoff — environment
#
# Copy to .env and fill in. Every variable below is actually read by the code;
# nothing here is aspirational. The file each one is read in is noted.
#
#   cp .env.example .env
# =============================================================================

# --- database ----------------------------------------------------------------
# Read by apps/api/src/db/pool.ts. Required by the API, the migrate/seed
# scripts, and the brief worker. TLS is enabled automatically for any host that
# is not localhost; append ?sslmode=disable to override.
DATABASE_URL=postgresql://handoff_user:handoff_password@localhost:5432/handoff_dev

# Max connections per pool. Default 10. Lower this when several instances share
# a small Postgres, or when going through a connection pooler.
# PGPOOL_MAX=10

# --- api ---------------------------------------------------------------------
# apps/api/src/index.ts
API_PORT=3001
NODE_ENV=development

# Comma-separated browser origins allowed to open a websocket.
# apps/api/src/realtime/SocketIO.ts
CORS_ORIGIN=http://localhost:3000

# Only used when running Socket.IO on its own server instead of attaching it to
# the Express app, which is the default. apps/api/src/realtime/SocketIO.ts
# WS_PORT=3002

# --- auth --------------------------------------------------------------------
# apps/api/src/middleware/auth.ts
#
# REQUIRED in production: the API refuses to start without it rather than fall
# back to the development secret, which is a literal in the source tree and so
# would let anyone forge a token for any user.
#   openssl rand -base64 48
JWT_SECRET=

# Token lifetime. Any ms/vercel-style duration. Default 7d.
JWT_EXPIRY=7d

# POST /auth/dev-login issues a valid session to any caller. It is mounted only
# when NODE_ENV is not "production" and returns 404 otherwise. On a shared dev
# box, set this and send it as the x-dev-login-key header.
# DEV_LOGIN_KEY=

# Guard for `npm -w @handoff/api run db:reset`, which drops every table. The
# script refuses a non-local host unless this is exactly "yes".
# ALLOW_REMOTE_DB_RESET=

# --- web ---------------------------------------------------------------------
# Read at build time by Next.js; must be present when `next build` runs.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Pre-fill the development sign-in and the "create task" project field so you do
# not have to paste UUIDs. apps/web/src/lib/session.ts
# NEXT_PUBLIC_DEV_USER_ID=
# NEXT_PUBLIC_DEV_PROJECT_ID=

# Port for `npm -w @handoff/web run dev`. Default 3000.
# WEB_PORT=3000

# --- handoff-brief worker ----------------------------------------------------
# Bull queue backend. Required by the worker; the API also uses it to receive
# "brief ready" notifications. Without it the worker will not start, and the API
# logs a warning and runs without brief notifications.
REDIS_URL=redis://localhost:6379

# workers/handoff-brief/src/worker.ts
# Credential for the Anthropic API. Without one the worker skips the model and
# writes the deterministic fallback brief instead of failing.
ANTHROPIC_API_KEY=

# Defaults to claude-opus-5 when unset. claude-sonnet-5 ($2/$10 per MTok vs
# $5/$25) is a reasonable cost choice for this short-form summarization job.
ANTHROPIC_MODEL=claude-sonnet-5

# Reasoning effort: low | medium | high | xhigh | max. Low by default —
# summarization under a hard deadline does not repay more.
ANTHROPIC_EFFORT=low

# Deadline for the model call. Past this the deterministic fallback runs.
BRIEF_TIMEOUT_MS=30000
BRIEF_MAX_TOKENS=8000

# Bull retry policy. The Anthropic SDK's own retries are disabled, so these are
# the only retries — otherwise 3 attempts x 3 SDK retries = 9 API calls.
BRIEF_ATTEMPTS=3
BRIEF_BACKOFF_MS=2000
