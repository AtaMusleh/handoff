DATABASE_URL=postgresql://handoff_user:handoff_password@localhost:5432/handoff_dev
API_PORT=3001
API_URL=http://localhost:3001
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
ANTHROPIC_API_KEY=sk-your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRY=7d
LOG_LEVEL=info

# --- web (development identity; NOT authentication) ---
# Pre-fills the dashboard identity prompt so the stack can be run end to end
# before auth middleware exists. Anyone can change it in the browser.
NEXT_PUBLIC_DEV_USER_ID=
NEXT_PUBLIC_DEV_PROJECT_ID=

# --- realtime ---
# Gateway port, only used when running Socket.IO on its own server rather than
# attaching it to the Express app.
WS_PORT=3002
# Comma-separated browser origins allowed to open a websocket.
CORS_ORIGIN=http://localhost:3000
