{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@handoff/domain": ["packages/domain/src/index.ts"],
      "@handoff/domain/*": ["packages/domain/src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src/**/*",
    "apps/*/src/**/*",
    "workers/*/src/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/dist"]
}
